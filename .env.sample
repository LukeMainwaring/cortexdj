# Environment
ENVIRONMENT=development

# OpenAI API key: the agents when a *_MODEL is openai:*. Leave blank otherwise.
OPENAI_API_KEY=

# Anthropic API key: the agents on the default models.
ANTHROPIC_API_KEY=

# Agent model (provider:model, e.g. anthropic:claude-sonnet-5-5 or openai:gpt-6.1-sol).
# Default is Anthropic.
AGENT_MODEL=anthropic:claude-sonnet-5-5
# Reasoning effort for every tool-using agent (built with build_agent): minimal, low,
# medium, high, xhigh, or max. Blank or unset keeps each provider's own default, which differs by model.
AGENT_REASONING_EFFORT=

# Per-agent models. Blank or unset keeps the default shown; thread titles run on Haiku
# because a 3-6 word summary needs no bigger model. On another provider, set it too.
# THREAD_TITLE_MODEL=anthropic:claude-haiku-5-5

# The model the eval judges grade on (tests/evals). Pinned apart from AGENT_MODEL and a tier
# above it (docs/adr/0004); the default needs ANTHROPIC_API_KEY even when the agents run on
# another provider, so on another provider set this too. Run the golden set after changing it.
# EVAL_JUDGE_MODEL=anthropic:claude-opus-5-5


# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cortexdj
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Spotify (optional). Blank ID or secret: the app boots, the assistant's Spotify search is
# unavailable, and mood playlists are saved locally. Create an app at
# developer.spotify.com/dashboard and register the redirect URI below on it, exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8003/api/spotify/callback
# Where the OAuth callback sends the browser back to.
# FRONTEND_URL=http://localhost:3003

# Frontend → backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8003

# Pydantic Logfire (optional observability: FastAPI, SQLAlchemy, and the agent).
# Leave blank and nothing is sent; spans still print to the terminal. See
# backend/src/cortexdj/core/observability.py.
LOGFIRE_TOKEN=
