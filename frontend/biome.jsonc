{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "vcs": {
    /* core turns on vcs.useIgnoreFile, but the .gitignore is at the repo root and `root`
       resolves against the cwd; the one generated path it would cover is excluded below */
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "**/*",
      "!.next",
      "!api/generated",
      /* the OpenAPI export that generate-client writes before openapi-ts reads it */
      "!api/scripts",
      /* shadcn-generated; edits are overwritten on the next `shadcn add` */
      "!components/ui",
      /* shadcn-generated by the sidebar component, same as components/ui */
      "!hooks/use-mobile.tsx"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        /* Tailwind's @ rules (@theme, @custom-variant, @apply) */
        "noUnknownAtRules": "off",
        /* Biome's type inference doesn't follow ref mutation or TanStack Query's result
           types, and reads runtime guards on a value cast from unknown as dead code, so
           most of its hits here are conditions that do change */
        "noUnnecessaryConditions": "off"
      },
      "complexity": {
        /* Its suggested rewrites (De Morgan on JSX conditions) read worse than the original */
        "useSimplifiedLogicExpression": "off"
      },
      "performance": {
        /* Demands useCallback for every handler prop, including on DOM elements and
           unmemoized components, where a stable identity buys nothing */
        "noJsxPropsBind": "off"
      },
      "correctness": {
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use <Button> from @/components/ui/button.",
              "input": "Use <Input> from @/components/ui/input. A hidden file input or a non-text input (type=\"range\") is allowed with a biome-ignore giving the reason.",
              "textarea": "Use <Textarea> from @/components/ui/textarea.",
              "hr": "Use <Separator> from @/components/ui/separator."
            }
          }
        }
      },
      "style": {
        /* The hook locations below restate this list without the generated-client ban:
           an override replaces a rule's options rather than merging them */
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "ai": {
                "importNames": [
                  "streamText",
                  "generateText",
                  "streamObject",
                  "generateObject"
                ],
                "message": "AI SDK UI only: the backend emits the stream, and Core in the AI SDK docs is a spec for the backend, not code for the frontend."
              }
            },
            "patterns": [
              {
                "group": ["../**"],
                "message": "Import relatively only from the same directory or below it; use the @/ alias otherwise."
              },
              {
                "group": ["@/features/**", "!@/features/tool-panel-registry"],
                "message": "A feature slice is reached only through @/features/tool-panel-registry; a slice never imports another slice."
              },
              {
                "group": [
                  "@/api/generated",
                  "@/api/generated/**",
                  "!@/api/generated/types.gen"
                ],
                "message": "Call the generated client through a TanStack Query hook (api/hooks/, or a slice's use-<name>.ts or .tsx); only types.gen may be imported elsewhere."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      /* The query-hook locations: the generated client is wrapped here */
      "includes": [
        "api/hooks/**",
        "features/*/use-*.ts",
        "features/*/use-*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "ai": {
                    "importNames": [
                      "streamText",
                      "generateText",
                      "streamObject",
                      "generateObject"
                    ],
                    "message": "AI SDK UI only: the backend emits the stream, and Core in the AI SDK docs is a spec for the backend, not code for the frontend."
                  }
                },
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "Import relatively only from the same directory or below it; use the @/ alias otherwise."
                  },
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/tool-panel-registry"
                    ],
                    "message": "A feature slice is reached only through @/features/tool-panel-registry; a slice never imports another slice."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
